# ==============================================================================
#  gcp-artifact-registry — terraform.tfvars
# ==============================================================================
#  Copy this file to `terraform.tfvars`, set the values, then run:
#      tofu init && tofu apply        (or:  terraform init && terraform apply)
#
# AUTHENTICATION — Google Cloud:
#   The google provider authenticates via Google's Application Default
#   Credentials (ADC) chain unless you override it.
#   Quick start: gcloud auth application-default login (for Terraform/ADC).
#   Also `gcloud auth login` for the CLI itself and `gcloud config set project
#   <id>` to set the default project.
#   Environment variables Terraform reads:
#     GOOGLE_CREDENTIALS  (secret) — Service-account key as a file path OR raw JSON string (provider-specific, checked first).
#     GOOGLE_APPLICATION_CREDENTIALS  (secret) — Standard ADC path to a key/external-account JSON file (used by WIF and the SDK).
#     GOOGLE_PROJECT — Default project id for resources; alt: GOOGLE_CLOUD_PROJECT, GCLOUD_PROJECT, CLOUDSDK_CORE_PROJECT.
#     GOOGLE_REGION — Default region; alt: GCLOUD_REGION, CLOUDSDK_COMPUTE_REGION.
#     GOOGLE_ZONE — Default zone; alt: GCLOUD_ZONE, CLOUDSDK_COMPUTE_ZONE.
#   Full guide (auth + remote state):  docs/CONNECTING-PROVIDERS.md#gcp
#
#  Secrets below read "REPLACE_ME" — never commit real secrets. Prefer
#  TF_VAR_<name> environment variables or a secrets manager.
#  Status: static-validated, live-test pending (see README.md).
# ==============================================================================


# ------------------------------------------------------------------------------
#  REQUIRED — you must set these
# ------------------------------------------------------------------------------

# project_id  —  string  (REQUIRED)
#   GCP project ID that hosts the repositories.
#   Constraint: project_id must be a valid GCP project ID (6-30 chars, lowercase
#   letters, digits, hyphens).
project_id = "example-project-123456"

# location  —  string  (REQUIRED)
#   Region (e.g. us-central1) or multi-region (us, europe, asia) for all
#   repositories in this module.
location   = "us-central1"

# repositories  —  map  (REQUIRED)
#   Repositories keyed by repository_id. mode selects STANDARD_REPOSITORY
#   (default), REMOTE_REPOSITORY (set remote.public_upstream) or
#   VIRTUAL_REPOSITORY (set virtual_upstreams; sibling repos may be referenced
#   by key). reader_members / writer_members get
#   roles/artifactregistry.reader|writer on the repo.
#   Constraint: Each map key is the repository_id: 1-63 chars, lowercase
#   letters, digits and hyphens, starting with a letter.
repositories = {
  "app-images" = {
    format = "DOCKER"
    cleanup_policies = {
      keep-latest-10 = {
        action               = "KEEP"
        most_recent_versions = { keep_count = 10 }
      }
      delete-stale-untagged = {
        action    = "DELETE"
        condition = { tag_state = "UNTAGGED", older_than = "2592000s" }
      }
    }
    reader_members = ["serviceAccount:gke-nodes@example-project-123456.iam.gserviceaccount.com"]
    writer_members = ["serviceAccount:ci-builder@example-project-123456.iam.gserviceaccount.com"]
  }

  "dockerhub-proxy" = {
    format = "DOCKER"
    mode   = "REMOTE_REPOSITORY"
    remote = { public_upstream = "DOCKER_HUB" }
  }

  "all-images" = {
    format = "DOCKER"
    mode   = "VIRTUAL_REPOSITORY"
    virtual_upstreams = [
      { id = "internal", repository = "app-images", priority = 100 },
      { id = "dockerhub", repository = "dockerhub-proxy", priority = 1 },
    ]
  }
}

# ------------------------------------------------------------------------------
#  OPTIONAL — defaults shown; uncomment a line to override
# ------------------------------------------------------------------------------

# labels  —  map  (optional, default: {})
#   Labels merged into every repository's labels.
labels = {
  environment = "example"
  managed_by  = "iac-bazaar"
}
